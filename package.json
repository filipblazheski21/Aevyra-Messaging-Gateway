{
  "name": "aevyra-messaging-gateway",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": "24.x", "npm": "11.x" },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/next.mjs dev apps/web --hostname 127.0.0.1",
    "start": "node scripts/next.mjs start apps/web --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env apps/worker/src/index.ts",
    "worker:check": "node --env-file-if-exists=.env apps/worker/src/index.ts --check",
    "db:up": "docker compose --env-file .env.admin up -d --wait postgres",
    "db:stop": "docker compose --env-file .env.admin stop postgres",
    "db:migrate": "node --env-file-if-exists=.env.admin packages/db/src/migrate-cli.ts up",
    "db:migrate:status": "node --env-file-if-exists=.env.admin packages/db/src/migrate-cli.ts status",
    "db:provision": "node --env-file-if-exists=.env --env-file-if-exists=.env.admin packages/db/src/provision-cli.ts",
    "test:db": "node --env-file-if-exists=.env.admin --test \"packages/db/test/*.integration.ts\"",
    "test:auth": "node --env-file-if-exists=.env.admin --test apps/web/test/auth.integration.ts",
    "test:organizations": "node --env-file-if-exists=.env.admin --test apps/web/test/organizations.integration.ts",
    "test:imports": "node --env-file-if-exists=.env.admin --test apps/web/test/imports.integration.ts",
    "test:contact-imports": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-imports.integration.ts",
    "test:contact-import-http": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-import-http.integration.ts",
    "test:contacts": "node --env-file-if-exists=.env.admin --test apps/web/test/contacts.integration.ts",
    "test:contact-list-refresh": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-list-refresh.integration.ts",
    "test:contact-suppressions": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-suppressions.integration.ts",
    "test:contact-bases": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-bases.integration.ts",
    "test:contact-basis-http": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-basis-http.integration.ts",
    "test:contact-basis-ui": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-basis-ui.integration.ts",
    "test:contact-basis-write-ui": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-basis-write-ui.integration.ts",
    "test:contact-suppression-http": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-suppression-http.integration.ts",
    "test:contact-suppression-ui": "node --env-file-if-exists=.env.admin --test apps/web/test/contact-suppression-ui.integration.ts",
    "test:test-helpers": "node --test apps/web/test/browser-test.test.ts packages/db/test/test-database.test.ts",
    "auth:create-user": "node --env-file-if-exists=.env --env-file-if-exists=.env.admin apps/web/scripts/create-user.ts",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --env-file-if-exists=.env --test \"apps/**/*.test.ts\" \"packages/**/*.test.ts\"",
    "build": "next build apps/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
