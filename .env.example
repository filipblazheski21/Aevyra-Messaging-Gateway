DATABASE_URL=postgresql://aevyra_app:replace_with_random_app_password@127.0.0.1:5432/aevyra_local
TZ=Europe/Skopje
REAL_SENDING_ENABLED=false
# Генерирајте 32 случајни бајти, кодирани како base64url. Видете README.md.
AUTH_SECRET=replace_with_random_auth_secret
AUTH_BASE_URL=http://127.0.0.1:3000
AUTH_LOCAL_HTTP=true
# Опционално за директно испраќање преку локален SMSGate сервер
SMSGATE_URL=http://127.0.0.1:8080
SMSGATE_USER=sms
SMSGATE_PASSWORD=replace_with_smsgate_password
